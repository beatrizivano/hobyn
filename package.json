{
  "name": "Hobyn",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup:env": "node scripts/setup-local.mjs",
    "db:up": "docker compose up -d --wait mysql",
    "db:stop": "docker compose stop mysql",
    "db:setup": "corepack pnpm --filter api db:generate && corepack pnpm --filter api db:migrate && corepack pnpm --filter api db:seed",
    "dev": "node scripts/dev.mjs",
    "dev:api": "corepack pnpm --filter api dev",
    "dev:web": "corepack pnpm --filter web dev",
    "test": "corepack pnpm --filter api test && corepack pnpm --filter web test",
    "build": "corepack pnpm --filter web build",
    "lint": "corepack pnpm --filter web lint",
    "typecheck": "corepack pnpm --filter web typecheck",
    "test:integration": "corepack pnpm --filter web test:integration",
    "test:session": "corepack pnpm --filter api test:session",
    "test:records": "corepack pnpm --filter api test:records",
    "test:invites": "corepack pnpm --filter api test:invites",
    "test:rankings": "corepack pnpm --filter api test:rankings",
    "test:profile-group-photos": "corepack pnpm --filter api test:profile-group-photos",
    "test:password-email": "corepack pnpm --filter api test:password-email"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "dependencies": {
    "zod": "^4.6.5"
  }
}
