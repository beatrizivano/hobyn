# API no Windows, MySQL no Docker.
DATABASE_URL=mysql://hobyn:hobyn_dev_password@127.0.0.1:3307/hobyn
PORT=3030
WEB_ORIGIN=http://localhost:5174
# O setup substitui este marcador por uma chave aleatoria.
JWT_ACCESS_SECRET=GENERATE_WITH_SETUP_LOCAL
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# O seed cria a regra de cooperacao sem sobrescrever a existente.
BONUS_COOPERATIVO_MULTIPLICADOR=1.2

# Diretório persistente relativo a apps/api (ou caminho absoluto).
UPLOAD_DIR=storage/uploads

# Em desenvolvimento, os links são exibidos no terminal da API.
MAIL_MODE=log
MAIL_FROM=Hobyn <noreply@localhost>
EMAIL_VERIFICATION_REQUIRED=false
# Para produção: MAIL_MODE=smtp e remetente autorizado no domínio.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
