# API no Windows, MySQL no Docker.
DATABASE_URL=mysql://hobyn:hobyn_dev_password@127.0.0.1:3307/hobyn
PORT=3030
WEB_ORIGIN=http://localhost:5173
# O setup substitui este marcador por uma chave aleatoria.
JWT_ACCESS_SECRET=GENERATE_WITH_SETUP_LOCAL
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# O seed cria a regra de cooperacao sem sobrescrever a existente.
BONUS_COOPERATIVO_MULTIPLICADOR=1.2
